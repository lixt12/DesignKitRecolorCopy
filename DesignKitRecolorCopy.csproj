<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon></ApplicationIcon>
    <AssemblyName>DesignKitRecolorCopy</AssemblyName>
    <RootNamespace>DesignKitRecolorCopy</RootNamespace>
    <Product>美图换色图复制工具</Product>
    <Version>1.0.0</Version>
    <!-- 单文件发布时把 WebView2 等原生 DLL 打进 exe 并在首次运行时释放，避免 "Dll was not found" -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>

</Project>
